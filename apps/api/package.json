{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "description": "HTTP API of the modular monolith on Hono, deployed to Cloudflare Workers (docs/adr/012-api-modular-monolith.md)",
  "scripts": {
    "dev": "wrangler dev --port 3001",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/db": "workspace:*",
    "@repo/observability": "workspace:*",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3",
    "wrangler": "4.149.0"
  }
}

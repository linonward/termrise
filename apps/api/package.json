{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "description": "HTTP API of the modular monolith on Hono, deployed to Cloudflare Workers (docs/adr/012-api-modular-monolith.md)",
  "scripts": {
    "dev": "wrangler dev --port 3001",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "admin:adjust": "tsx scripts/admin-adjust.ts",
    "admin:export-user": "tsx scripts/admin-export-user.ts",
    "admin:delete-user": "tsx scripts/admin-delete-user.ts"
  },
  "dependencies": {
    "@repo/admin": "workspace:*",
    "@repo/ai": "workspace:*",
    "@repo/analytics": "workspace:*",
    "@repo/auth": "workspace:*",
    "@repo/billing": "workspace:*",
    "@repo/config": "workspace:*",
    "@repo/credits": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/observability": "workspace:*",
    "@repo/research": "workspace:*",
    "@repo/storage": "workspace:*",
    "@repo/tasks": "workspace:*",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "drizzle-orm": "^0.45.3",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "4.149.0"
  }
}

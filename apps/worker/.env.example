# apps/worker for local development (pnpm dev:worker); copy to apps/worker/.env.
# docs/architecture/environment.md#worker
DATABASE_URL=postgresql://postgres:postgres@localhost:54330/termrise_local
WORKER_QUEUE=bullmq
REDIS_URL=redis://localhost:63790/0
SCAN_INTERVAL_MS=3000
PORT=8080
# Only fake providers exist so far; they make up their data.
KEYWORD_PROVIDER=fake
ANALYST_PROVIDER=fake
ALLOW_FAKE_PROVIDERS=1
# 1: collect Hacker News into the radar every TREND_INTERVAL_MS (public API, no key).
# Radar is off since S60 (docs/roadmap.md): new words cover discovery.
# HACKER_NEWS_ENABLED=1
TREND_INTERVAL_MS=3600000
# Real opportunity analysis: paid calls, charged to each project's AI budget.
# ANALYST_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# Real keyword data and SERP: paid calls, charged to each project's data budget.
# KEYWORD_PROVIDER=dataforseo
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# The service's caps on paid calls per calendar month (UTC), all projects together.
# Defaults: 10 (data) and 2 (AI).
MONTHLY_DATA_BUDGET_USD=10
MONTHLY_AI_BUDGET_USD=2
# 1: collect Google Trends Trending Now (US) into the radar every TREND_INTERVAL_MS.
# GOOGLE_TRENDS_ENABLED=1
# Keyword pool (docs/product/keyword-pool.md#rounds): 1 runs a round every day from
# POOL_DAILY_HOUR_UTC (0 is 08:00 in Shanghai). Paid calls, charged to the pool's daily
# budget; the monthly cap above still applies, so raise it (0.5 a day is about 15 a month).
# POOL_DAILY_ENABLED=1
# POOL_DAILY_HOUR_UTC=0
# POOL_ROUND_EVERY_DAYS=7
# POOL_DAILY_DATA_BUDGET_USD=0.5
# POOL_DEEP_CHECKS=6
# New words (docs/product/keyword-pool.md#new-words): 1 collects rising queries under the
# root words and judges them every day, with their own daily budgets.
# NEW_WORDS_ENABLED=1
# NEW_WORDS_HOUR_UTC=0
# NEW_WORDS_DAILY_DATA_BUDGET_USD=0.5
# NEW_WORDS_DAILY_AI_BUDGET_USD=0.05
# NEW_WORDS_SCREENS=40   # step 1: words measured on the Trends curve, 4 per $0.011 call
# NEW_WORDS_CHECKS=12    # step 2: words that passed, checked in depth (search results, volume)
# NEW_WORD_ROOTS=          # default: about 110 narrow roots in new-words.ts DEFAULT_ROOTS
# NEW_WORD_ROOTS_PER_DAY=15 # the longest unscanned first: the list turns over in about a week
# Launch sites (docs/product/keyword-pool.md#launch-sites): 1 reads Show HN every 6 hours
# for new websites; the AI reading is charged to NEW_WORDS_DAILY_AI_BUDGET_USD.
# LAUNCH_SITES_ENABLED=1
# Platform sites (docs/product/keyword-pool.md#platform-sites): 1 reads Common Crawl's list
# of vercel.app, github.io and pages.dev hosts and checks 300 a day for Google traffic.
# PLATFORM_SITES_ENABLED=1
# New-word origins (docs/product/keyword-pool.md#origins) search Hacker News, Hugging Face
# and GitHub for free with real keyword data. A token (no scopes) raises GitHub's limit.
# GITHUB_TOKEN=
# PLATFORM_SITES_DAILY_DATA_BUDGET_USD=0.066

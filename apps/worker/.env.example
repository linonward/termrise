# apps/worker for local development (pnpm dev:worker); copy to apps/worker/.env.
# docs/architecture/environment.md#worker
DATABASE_URL=postgresql://postgres:postgres@localhost:54330/termrise_local
WORKER_QUEUE=bullmq
REDIS_URL=redis://localhost:63790/0
SCAN_INTERVAL_MS=3000
PORT=8080
# Only fake providers exist so far; they make up their data.
KEYWORD_PROVIDER=fake
ANALYST_PROVIDER=fake
ALLOW_FAKE_PROVIDERS=1
# 1: collect Hacker News into the radar every TREND_INTERVAL_MS (public API, no key).
HACKER_NEWS_ENABLED=1
TREND_INTERVAL_MS=3600000

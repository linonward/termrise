{
  "name": "worker",
  "version": "0.0.0",
  "private": true,
  "description": "Background worker: BullMQ on Redis; runs queued research runs",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/db": "workspace:*",
    "@repo/jobs": "workspace:*",
    "@repo/observability": "workspace:*",
    "@repo/research": "workspace:*",
    "bullmq": "^6.3.11",
    "ioredis": "^6.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "4.23.15",
    "typescript": "^5.9.3"
  }
}

{
  "$schema": "./node_modules/turbo/schema.json",
  "agentGuidance": false,
  "envMode": "loose",
  "globalDependencies": ["product.config.ts"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_*", "SENTRY_*", "VERCEL_ENV"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

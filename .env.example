# Acme environment contract — see docs/architecture/environment.md
# Copy to .env.local (never commit). Values below are placeholders.
# The web app only renders pages; apps/api has its own variables in apps/api/.dev.vars
# (docs/architecture/environment.md#api-bindings).

APP_URL=http://localhost:3000

# apps/api (pnpm dev:api)
NEXT_PUBLIC_API_URL=http://localhost:3001
# Google One Tap (public client ID)
GOOGLE_CLIENT_ID=
# Local SeaweedFS (docker compose up -d storage): lets the CSP allow browser uploads to it.
# Not allowed in production.
# R2_ENDPOINT=http://localhost:8333

SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=

# Not read by the web app: pnpm db:migrate and the admin scripts (apps/api/scripts).
# Neon pooled connection string; locally the dev/{topic} branch of this worktree
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/app?sslmode=verify-full&channel_binding=require
# Tests only — must point at local Docker / CI PostgreSQL
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54330/app_test_topic

# Only pnpm waffo:products; the key decides test or production
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
WAFFO_STORE_ID=

# Acme environment contract — see docs/architecture/environment.md
# Copy to .env.local (never commit). Values below are placeholders.

APP_URL=http://localhost:3000

# Neon pooled connection string; locally the dev/{topic} branch of this worktree
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/app?sslmode=verify-full&channel_binding=require
# Tests only — must point at local Docker / CI PostgreSQL
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54330/app_test_topic

# apps/api (pnpm dev:api): Better Auth and the other APIs. Its own variables are in
# apps/api/.dev.vars (docs/architecture/environment.md#api-bindings).
NEXT_PUBLIC_API_URL=http://localhost:3001
# Google One Tap (public client ID)
GOOGLE_CLIENT_ID=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=app-dev
# Local SeaweedFS instead of the dev bucket (docker compose up -d storage); not allowed in production:
# R2_ACCOUNT_ID=local
# R2_ACCESS_KEY_ID=local
# R2_SECRET_ACCESS_KEY=local-secret
# R2_ENDPOINT=http://localhost:8333

# r2 | fake (fake is for E2E only; production must be r2)
STORAGE_PROVIDER=r2
# FAKE_STORAGE_DIR=.e2e-storage

# example | deepseek | fake (fake is for tests only; replace example with the product's provider)
TASK_PROVIDER=example
# Required when TASK_PROVIDER=deepseek; models: deepseek-flash | deepseek-v4-pro
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# waffo | fake (production must be waffo; a production build such as `next start`
# also needs ALLOW_FAKE_PROVIDERS=1 for any fake provider)
PAYMENT_PROVIDER=fake
# Waffo Pancake — the app's mode follows VERCEL_ENV (production → prod, otherwise test);
# the key must belong to the same environment. Only `pnpm waffo:products` picks the
# environment from the key.
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
WAFFO_STORE_ID=

SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Comma-separated user ids allowed into /admin; unset = no admins
ADMIN_USER_IDS=
